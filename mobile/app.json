{
  "expo": {
    "name": "Hungrie",
    "slug": "hungrieapp",
    "version": "1.0.2",
    "description": "Hungrie campus favorites in one place. Discover, choose, continue.",
    "orientation": "portrait",
    "icon": "./assets/app-icon/app-icon-1024.png",
    "scheme": "fastfood",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/app-icon/app-icon-1024.png",
      "supportsTablet": true,
      "buildNumber": "43",
      "bundleIdentifier": "com.hungrie.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/app-icon-1024.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.hungrie.app",
      "versionCode": 43,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/app-icon/app-icon-512.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-ios-scene-delegate",
      "./plugins/with-ios-15-pods",
      "@sentry/react-native/expo",
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon/app-icon-192.png",
          "color": "#FE8C00",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/hungrie.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7EF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#FFF7EF"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
