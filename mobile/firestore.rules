rules_version = '2';

// Firebase is the identity provider. Supabase is the only authorization and
// private application-data boundary. Firestore cannot evaluate canonical
// account_access state, so no authenticated legacy role, membership, owner
// field, or document ownership may grant private access here.
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog compatibility remains read-only and non-authoritative.
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if false;
    }

    match /menus/{menuId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /orderReviews/{reviewId} {
      allow read: if resource.data.status == "published";
      allow write: if false;
    }

    // Users, addresses, tokens, staff mappings, orders, unpublished reviews,
    // and every unknown path are private legacy data. Server Admin SDK jobs
    // bypass rules and remain available for migration/deletion operations.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
