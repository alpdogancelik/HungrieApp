# Keep Firebase order automation enabled until the coordinated Milestone 10
# development cutover. Use `supabase` only in the ignored project-specific
# environment file immediately before deploying the guarded legacy functions.
ORDER_AUTOMATION_BACKEND=firebase
# Production deployment parameters are mandatory exact identities. Values are
# intentionally placeholders and must never be inherited from non-production.
PRODUCTION_FIREBASE_PROJECT_ID=replace-with-dedicated-production-project-id
PRODUCTION_SUPABASE_PROJECT_REF=replace-with-dedicated-production-project-ref
