+    runId: "ruip6a_localtest",
+    expected,
+    retrieveMetadata,
+    persist: async value => snapshots.push(structuredClone(value)),
+    fetchImpl: timedFetch,
+    clock,
+    deadlineSignal: () => new AbortController().signal,
+  });
+  return { evidence, snapshots, requests };
