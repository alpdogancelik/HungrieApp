+      ...base,
+      endedAt: iso(endedMs),
+      elapsedMs: Math.max(0, endedMs - startedMs),
+      finalUrl: sanitizePersistentUrl(response.url || requested),
+      status: response.status,
+      responseSha256: sha256(body),
+      byteLength: body.length,
+      headers: safeHeaders(response.headers),
+      error: null,
+    };
