+      ...base,
+      endedAt: iso(endedMs),
+      elapsedMs: Math.max(0, endedMs - startedMs),
+      finalUrl: null,
+      status: null,
+      responseSha256: null,
+      byteLength: null,
+      headers: {},
+      error: sanitizeError(error),
+    };
