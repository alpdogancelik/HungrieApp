+  assert.equal(evidence.attempts[0].metadata.deploymentIdentifier, "candidate-deployment");
+  assert.ok(evidence.attempts[0].metadata.updatedAt);
+  assert.ok(evidence.attempts[0].metadata.retrievedAt);
