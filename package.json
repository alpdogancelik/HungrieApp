{
  "name": "hungrieapp",
  "private": true,
  "workspaces": [
    "mobile",
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "@grpc/grpc-js": "1.9.16",
    "@xmldom/xmldom": "0.8.15",
    "browserslist": "4.28.9",
    "fast-uri": "3.1.6",
    "protobufjs": "7.6.5",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "undici": "6.28.1",
    "websocket-driver": "0.7.5"
  },
  "scripts": {
    "start": "npm --prefix mobile run start",
    "android": "npm --prefix mobile run android",
    "ios": "npm --prefix mobile run ios",
    "web": "npm --prefix mobile run web",
    "lint": "npm --prefix mobile run lint",
    "test": "npm run test:js && npm run supabase:test",
    "test:js": "npm run test:admin-role-verification && npm run test:phase3-classification && npm --prefix functions run test:phase4-admin && npm --prefix functions run test:audit-migration-baseline && npm --prefix functions run test:supabase-auth-claims && npm --prefix functions run test:supabase-auth-probe && npm --prefix functions run test:catalog-migration && npm --prefix functions run test:identity-migration && npm --prefix functions run test:review-migration && npm --prefix functions run test:order-migration && npm run notification-worker:test && npm --prefix mobile run test:supabase-config && npm --prefix mobile run test:repositories && npm --prefix mobile run test:cart",
    "test:admin-role-verification": "node --test scripts/verify-admin-role.test.mjs scripts/provision-admin-role.test.mjs",
    "test:phase3-classification": "node --test scripts/phase3-classification-core.test.mjs",
    "notification-worker:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test supabase/functions/notification-worker/logic.test.mjs",
    "typecheck": "npx tsc --project mobile/tsconfig.json --noEmit",
    "expo:config": "npm --prefix mobile run expo:config",
    "build:packages": "npm run build --workspace @hungrie/config && npm run build --workspace @hungrie/domain && npm run build --workspace @hungrie/database-types",
    "build:proof": "npm run build:packages && npm run export:web --workspace @hungrie/restaurant && npm run build --workspace @hungrie/admin-web",
    "test:proof-output": "node scripts/check-phase1-web-output.mjs",
    "test:proof-hosting": "node scripts/check-phase1-hosting.mjs",
    "phase1:operations:local": "node scripts/check-phase1-operations.mjs",
    "phase1:development:migration": "node scripts/apply-phase1-development-migration.mjs",
    "phase1:development:policy-probe": "node scripts/probe-phase1-development-release-policy.mjs",
    "phase2:development:backup": "node scripts/backup-phase2-development.mjs",
    "phase2:development:migrations": "node scripts/apply-phase2-development-migrations.mjs",
    "phase2:development:firebase-probe": "node scripts/probe-phase2-development-firebase.mjs",
    "phase3:backup": "node scripts/backup-phase3-environment.mjs",
    "phase3:classify": "node scripts/phase3-classification.mjs",
    "phase3:staging:review": "node scripts/review-phase3-staging-batch.mjs",
    "phase3:staging:foundation": "node scripts/apply-phase3-staging-foundation.mjs",
    "phase3:development:migration": "node scripts/apply-phase3-development-migration.mjs",
    "phase3:staging:migration": "node scripts/apply-phase3-staging-migration.mjs",
    "phase3:recovery:migration": "node scripts/apply-phase3-recovery-migration.mjs",
    "phase3:verify": "node scripts/verify-phase3-hosted.mjs",
    "phase4:backup": "node scripts/backup-phase4-environment.mjs",
    "phase4:development:migration": "node scripts/apply-phase4-development-migration.mjs",
    "phase4:staging:review": "node scripts/review-phase4-staging.mjs",
    "phase4:staging:migration": "node scripts/apply-phase4-staging-migration.mjs",
    "phase4:staging:functions": "node scripts/deploy-phase4-staging-functions.mjs",
    "phase4:admin:check": "node scripts/check-phase4-admin.mjs",
    "phase4:staging:bootstrap-admin": "node scripts/bootstrap-phase4-first-super-admin.mjs",
    "typecheck:proof": "npm run typecheck --workspace @hungrie/restaurant && npm run typecheck --workspace @hungrie/admin-web",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --local && npm run supabase:realtime:policy:local",
    "supabase:lint": "supabase db lint --local --schema public,private,migration --level error --fail-on error",
    "supabase:test": "supabase test db --local supabase/tests && node scripts/test-supabase-milestone3-concurrency.mjs && node scripts/test-admin-role-concurrency.mjs && node scripts/test-phase2-invitation-concurrency.mjs",
    "supabase:migration:new": "supabase migration new",
    "supabase:types": "supabase gen types typescript --local --schema public > packages/database-types/src/database.generated.ts",
    "phase1:staging:migration": "node scripts/apply-phase1-staging-migration.mjs",
    "phase1:staging:policy-probe": "node scripts/probe-phase1-staging-release-policy.mjs",
    "supabase:provision": "node scripts/provision-supabase-projects.mjs",
    "supabase:auth:capture": "node scripts/capture-supabase-hungrie-token.mjs",
    "supabase:environment": "node scripts/supabase-environment.mjs",
    "supabase:firebase-auth": "node scripts/configure-supabase-firebase-auth.mjs",
    "supabase:mobile-env": "node scripts/configure-supabase-mobile-env.mjs",
    "supabase:cloud:verify": "node scripts/verify-supabase-cloud.mjs",
    "supabase:schema:verify": "node scripts/verify-supabase-milestone2.mjs",
    "supabase:security:verify": "node scripts/verify-supabase-milestone3.mjs",
    "supabase:security:test:hosted": "node scripts/test-supabase-milestone3-hosted.mjs",
    "supabase:security:probe": "node scripts/probe-supabase-milestone3-firebase.mjs",
    "catalog:migrate": "npm --prefix functions run catalog:migrate --",
    "identity:migrate": "npm --prefix functions run identity:migrate --",
    "review:migrate": "npm --prefix functions run review:migrate --",
    "order:migrate": "npm --prefix functions run order:migrate --",
    "supabase:catalog:verify": "node scripts/verify-supabase-milestone5.mjs",
    "catalog:parity": "node scripts/compare-catalog-parity.mjs",
    "catalog:test:local": "node scripts/test-supabase-catalog-import-local.mjs",
    "identity:test:local": "node scripts/test-supabase-identity-import-local.mjs",
    "review:test:local": "node scripts/test-supabase-review-import-local.mjs",
    "order:test:local": "node scripts/test-supabase-order-import-local.mjs",
    "order:verify:hosted": "node scripts/verify-supabase-milestone8.mjs",
    "order:probe:hosted": "node scripts/probe-supabase-milestone8-firebase.mjs",
    "supabase:identity:verify": "node scripts/verify-supabase-milestone6.mjs",
    "supabase:identity:probe": "node scripts/probe-supabase-milestone6-firebase.mjs",
    "supabase:reviews:verify": "node scripts/verify-supabase-milestone7.mjs",
    "supabase:realtime:policy:local": "node scripts/apply-supabase-realtime-policy.mjs --target=local --confirm=local",
    "supabase:realtime:policy:development": "node scripts/apply-supabase-realtime-policy.mjs --target=development --confirm=development",
    "supabase:realtime:deploy": "node scripts/deploy-supabase-milestone9.mjs --confirm=development",
    "supabase:realtime:verify": "node scripts/verify-supabase-milestone9.mjs",
    "supabase:realtime:probe": "node scripts/probe-supabase-milestone9-realtime.mjs",
    "supabase:milestone10:deploy": "node scripts/deploy-supabase-milestone10.mjs",
    "supabase:environment:deploy": "node scripts/deploy-supabase-milestone10.mjs",
    "supabase:runtime-mode": "node scripts/set-supabase-runtime-mode.mjs",
    "catalog:production-release": "node scripts/create-production-catalog-release.mjs",
    "firebase:archive": "npm --prefix functions run firebase:archive --",
    "firebase:archive:restore-test": "npm --prefix functions run firebase:archive:restore-test --",
    "backup:postgres": "node scripts/backup-supabase-postgres.mjs",
    "backup:bucket:configure": "node scripts/configure-backup-bucket.mjs",
    "backup:postgres:restore-drill": "node scripts/restore-supabase-postgres-drill.mjs",
    "supabase:milestone11:verify": "node scripts/verify-supabase-milestone11-environment.mjs",
    "supabase:release:apply": "node scripts/apply-supabase-release.mjs",
    "supabase:health": "node scripts/check-supabase-health.mjs",
    "supabase:staging:clean-test-data": "node scripts/clean-supabase-staging-test-data.mjs",
    "supabase:milestone10:verify": "node scripts/verify-supabase-milestone10.mjs",
    "supabase:milestone10:probe": "node scripts/probe-supabase-milestone10-firebase.mjs",
    "admin:verify": "node scripts/verify-admin-role.mjs",
    "admin:provision": "node scripts/provision-admin-role.mjs"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "supabase": "2.116.0",
    "typescript": "~5.9.2"
  }
}
